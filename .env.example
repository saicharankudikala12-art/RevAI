# RevAI Application Configuration
APP_NAME=RevAI
# Set to 'production' for live deployments, or 'development' for local work
APP_ENV=development
HOST=0.0.0.0
PORT=8000

# Security: In production (APP_ENV=production), SECRET_KEY MUST be a random secret string (e.g., openssl rand -hex 32)
# The application will refuse to start in production if the default development key is used.
SECRET_KEY=revai-secure-test-session-key-dev-default

# CORS Allowed Origins (Comma-separated)
# In unified deployment (same origin), CORS is not needed for the app itself, but can include authorized external domains.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

# File Upload Limits (in Megabytes)
MAX_UPLOAD_SIZE_MB=25

# AI Provider Configuration (Google Gemini)
# AI_API_KEY or GEMINI_API_KEY
AI_API_KEY=
AI_MODEL=gemini-3.8-flash

# Fallback: When True, safely generates grounded revision questions and flashcards even if Gemini credentials are missing/rate-limited
ALLOW_HEURISTIC_FALLBACK=True
